# Modellprovider
MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Workflow
MAX_QUESTIONS=12
OUTPUT_FILE=bewerbung_output.md

# Robustheit bei leeren Provider-Antworten
LLM_EMPTY_RETRIES=1
LLM_RETRY_DELAY_SECONDS=1.0

# Hartes Timeout pro Modellaufruf (Sekunden). Verhindert, dass ein träges oder
# hängendes (z. B. kostenloses) Modell den Coach blockiert; danach greift der
# begrenzte Retry und anschließend der Fallback.
LLM_TIMEOUT_SECONDS=90

# Optional für OpenAI-kompatible Endpoints
# MODEL=gpt-4o
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1

# ------------------------------------------------------------------ #
# Empfohlen für die öffentliche Web-Demo: OpenRouter mit Gratis-Modell
# OpenRouter ist OpenAI-kompatibel und funktioniert ohne Code-Änderung.
# Ein ":free"-Modell verursacht keine Kosten (nur Rate-Limits).
# Aktuelle Gratis-Modelle: https://openrouter.ai/models?max_price=0
# ------------------------------------------------------------------ #
# MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...

# Optional für Ollama
# MODEL=ollama/llama3.2
# OLLAMA_API_BASE=http://localhost:11434/v1

# Optional für Gemini über den OpenAI-kompatiblen Endpoint
# MODEL=gemini/<modellname>
# GEMINI_API_KEY=

# Optional für Azure OpenAI
# MODEL=azure/<deployment-name>
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-02-01

# ------------------------------------------------------------------ #
# Web-Demo (nur für das Hosting relevant, nicht für die CLI)
# ------------------------------------------------------------------ #
# Domain für automatisches HTTPS via Caddy (Deployment auf dem VPS).
# Für lokalen Test ohne TLS: SITE_ADDRESS=:80
# SITE_ADDRESS=coach.deine-domain.de

# Grenzen der öffentlichen Demo (Ressourcen- und Missbrauchsschutz)
# WEB_HOST=0.0.0.0
# WEB_PORT=8000
# WEB_MAX_SESSIONS=5
# WEB_IDLE_TIMEOUT_SECONDS=300
# WEB_MAX_SESSION_SECONDS=1800
